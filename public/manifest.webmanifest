{
  "id": "./",
  "name": "Relic — платформа для фрилансеров",
  "short_name": "Relic",
  "description": "Профиль, Workspace, обучение по нишам, биржа и чаты.",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#e9e7e2",
  "theme_color": "#e9e7e2",
  "icons": [
    {
      "src": "app/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "app/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "app/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Workspace",
      "url": "./workspace/",
      "icons": [
        {
          "src": "app/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Чаты",
      "url": "./messages/",
      "icons": [
        {
          "src": "app/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Биржа",
      "url": "./jobs/",
      "icons": [
        {
          "src": "app/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
